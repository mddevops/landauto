# Landflow — E2E (Playwright) environment template.
#
# Used only by the Playwright web server (APP_ENV=e2e).
# tests/browser/support/prepare-e2e.mjs copies this file to .env.e2e (git-ignored)
# before every run, generates a fresh APP_KEY and points DB_DATABASE to a
# recreated SQLite file. Test-only values: no production services or credentials.

APP_NAME=Landflow
APP_ENV=e2e
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8200

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

CATALOG_DB_DRIVER=sqlite
CATALOG_DB_DATABASE=database/e2e-catalog.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

FORMS_CAPTCHA_DRIVER=fake

LANDFLOW_PUBLIC_DOMAIN=localhost
LANDFLOW_PUBLIC_SCHEME=http
LANDFLOW_PUBLIC_PORT=8200

MAIL_MAILER=array
MAIL_FROM_ADDRESS="e2e@landflow.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
